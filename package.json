{
  "name": "sofia-15-anos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Convite digital imersivo para os 15 anos de Sofia.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-check.mjs",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "photos": "node scripts/optimize-photos.mjs",
    "crests": "node scripts/prepare-crests.mjs",
    "share": "node scripts/generate-share-assets.mjs",
    "gifts:images": "node scripts/optimize-gift-images.mjs",
    "validate": "npm run lint && npm run test && npm run build && npm run check:secrets",
    "frames": "node scripts/prepare-frames.mjs",
    "guests:import": "node scripts/import-guests.mjs",
    "agent:facts": "node scripts/build-agent-facts.mjs",
    "db:schema": "node scripts/export-schema.mjs",
    "agent:chat": "node scripts/agent-chat.mjs",
    "agent:eval": "node scripts/agent-eval.mjs",
    "messages:book": "node scripts/messages-book.mjs",
    "deploy:vps": "npm run build && node scripts/deploy-vps.mjs",
    "deploy:profeta": "node scripts/deploy-profeta.mjs",
    "profeta:cartao": "node scripts/profeta-cartao.mjs",
    "profeta:baixar": "node scripts/profeta-baixar.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/pinyon-script": "5.3.0",
    "gsap": "3.15.0",
    "lucide-react": "1.50.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright-core": "1.64.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
