# ---------------------------------------------------------------------------
# Variáveis de ambiente do convite — copie este arquivo para `.env.local`
# e preencha com os valores reais. NUNCA versione o arquivo preenchido.
# ---------------------------------------------------------------------------

# O site não usa banco de dados: a confirmação de presença é feita pela Professora
# Aifos no WhatsApp (segredos das funções em supabase/functions/.env).

# Domínio definitivo do site, sem barra no final (ex.: https://sofia15anos.com.br).
# Quando preenchido, habilita a URL canônica e a imagem absoluta de compartilhamento (Open Graph).
VITE_SITE_URL=

# "true" permite que buscadores indexem o site. Padrão: não indexar (convite pessoal).
VITE_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# Só para scripts locais (NUNCA com prefixo VITE_: não podem ir para o navegador)
# ---------------------------------------------------------------------------

# Importação da lista de convidados (npm run guests:import). A secret key
# (sb_secret_...) ou a service_role ignoram o RLS: guarde só aqui, em .env.local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
