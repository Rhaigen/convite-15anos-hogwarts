# -----------------------------------------------------------------------------
# Segredos das Edge Functions da Professora Aifos (WhatsApp).
# Copie para supabase/functions/.env (não versionado) e envie ao projeto com:
#   npx supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem no ambiente das funções.
# -----------------------------------------------------------------------------

# Claude (agente) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI (transcrição dos áudios do WhatsApp)
OPENAI_API_KEY=

# Evolution API (instância conectada ao número da Aifos)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Segredo longo e aleatório (mínimo 32 caracteres) que a Evolution envia ao webhook no
# cabeçalho x-sofia-secret. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# (O segredo do cron não fica aqui: a migração o cria no Vault do Supabase.)
WEBHOOK_SECRET=

# Telefones do organizador (só dígitos, com 55 e DDD), separados por vírgula.
ADMIN_PHONES=

# Opcional: equipe da festa (cerimonial), no mesmo formato. Conversa com a Aifos sem ser convidado.
STAFF_PHONES=

# Opcional: O Profeta Diário (fotos e vídeos dos convidados, guardados na VPS; docs/arquitetura.md#o-profeta-diario).
# Sem PROFETA_API_URL/PROFETA_SECRET, fotos mandadas à Aifos seguem como antes (ela diz que não enxerga imagens).
# PROFETA_SECRET é o mesmo da stack convite-profeta na VPS (mínimo 32 caracteres, gerado como o WEBHOOK_SECRET).
PROFETA_API_URL=https://convite.example.com/api/profeta
PROFETA_SECRET=
# Endereço da página e palavra mágica (a mesma dos cartões das mesas e da VPS): a Aifos passa a convidados da lista.
PROFETA_URL=https://convite.example.com/profeta/
PROFETA_SENHA=
