# Copie para deploy/vps/deploy.env (fora do git) e preencha. Ver docs/arquitetura.md#hospedagem.
# Nome do Host no ~/.ssh/config desta máquina (o IP e a chave ficam lá, nunca no repositório).
VPS_SSH=
# Pasta do convite na VPS (montada no container Nginx como /srv/convite).
VPS_DIR=/opt/convite-sofia
# Endereço público, para conferir depois de cada envio.
VPS_URL=https://convite.example.com
# O Profeta Diário (npm run deploy:profeta / profeta:baixar): pasta do serviço na VPS (app/ e o disco dados/).
PROFETA_DIR=/opt/convite-profeta
# Comando, na VPS, que troca o container pela imagem nova (o agente da VPS informa). Vazio = só constrói.
PROFETA_RESTART=
